{
  "name": "@effect-template/api",
  "version": "0.2.2",
  "private": true,
  "description": "docker-git API controller",
  "main": "dist/src/main.js",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "prebuild": "bun run --cwd ../terminal build && bun run --cwd ../container build && bun run --cwd ../lib build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prestart": "bun run build",
    "start": "bun dist/src/main.js",
    "pretypecheck": "bun run --cwd ../terminal build && bun run --cwd ../container build && bun run --cwd ../lib build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:effect": "eslint --config eslint.effect-ts-check.config.mjs .",
    "lint:openapi-contract": "vitest run tests/openapi.test.ts",
    "pretest": "bun run --cwd ../terminal build && bun run --cwd ../container build && bun run --cwd ../lib build",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect-template/lib": "workspace:*",
    "@prover-coder-ai/docker-git-terminal": "workspace:*",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^4.0.0",
    "@effect/schema": "^0.75.5",
    "@fedify/fedify": "^2.4.0",
    "@fedify/vocab": "^2.4.0",
    "effect": "^4.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProverCoderAI/docker-git.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ProverCoderAI/docker-git/issues"
  },
  "homepage": "https://github.com/ProverCoderAI/docker-git#readme",
  "devDependencies": {
    "@effect/vitest": "^4.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "fast-check": "4.10.2",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}

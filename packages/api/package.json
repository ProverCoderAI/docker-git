{
  "name": "@effect-template/api",
  "version": "0.1.0",
  "private": true,
  "description": "docker-git API controller",
  "main": "dist/src/main.js",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "prebuild": "bun run --cwd ../lib build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prestart": "bun run build",
    "start": "bun dist/src/main.js",
    "pretypecheck": "bun run --cwd ../lib build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "pretest": "bun run --cwd ../lib build",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect-template/lib": "workspace:*",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.106.0",
    "@effect/schema": "^0.75.5",
    "effect": "^3.21.2",
    "node-pty": "^1.1.0",
    "ws": "^8.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProverCoderAI/docker-git.git"
  },
  "bugs": {
    "url": "https://github.com/ProverCoderAI/docker-git/issues"
  },
  "homepage": "https://github.com/ProverCoderAI/docker-git#readme",
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^25.6.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}

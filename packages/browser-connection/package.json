    "novnc",
    "cdp",
    "effect",
    "hermes"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ProverCoderAI/docker-git/issues"
  },
  "homepage": "https://github.com/ProverCoderAI/docker-git#readme",
  "packageManager": "bun@1.3.11",
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "effect": "^3.12.0"
  }
}

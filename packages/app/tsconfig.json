{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowJs": true,
		"rootDir": ".",
		"outDir": "dist",
		"types": ["vitest", "vite/client"],
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"eslint/**/*",
		"src/**/*",
		"tests/**/*",
		"vite.config.ts",
		"vite.web.config.ts",
		"vitest.config.ts"
	],
	"exclude": ["dist", "node_modules"]
}

{
  "name": "@prover-coder-ai/docker-git-session-sync",
  "version": "1.0.71",
  "description": "Standalone docker-git AI agent session synchronization tool",
  "main": "dist/docker-git-session-sync.js",
  "bin": {
    "docker-git-session-sync": "dist/docker-git-session-sync.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && bun ../../scripts/mark-executable.mjs dist/docker-git-session-sync.js",
    "check": "bun run typecheck",
    "lint:effect": "eslint --config eslint.effect-ts-check.config.mjs .",
    "prepack": "bun run build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProverCoderAI/docker-git.git"
  },
  "keywords": [
    "docker-git",
    "session",
    "agents"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ProverCoderAI/docker-git/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ProverCoderAI/docker-git#readme",
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@effect/schema": "^0.75.5",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "fast-check": "4.10.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}

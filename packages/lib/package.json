{
  "name": "@effect-template/lib",
  "version": "1.2.1",
  "private": true,
  "description": "Shared business logic (docker-git orchestrator core)",
  "main": "dist/index.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "prebuild": "bun run --cwd ../auth-oauth build && bun run --cwd ../container build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prelint": "bun run --cwd ../auth-oauth build && bun run --cwd ../container build",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 PATH=../../scripts:$PATH vibecode-linter src/",
    "lint:effect": "NODE_OPTIONS=--max-old-space-size=4096 PATH=../../scripts:$PATH eslint --config eslint.effect-ts-check.config.mjs .",
    "pretypecheck": "bun run --cwd ../auth-oauth build && bun run --cwd ../container build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "bun run --cwd ../auth-oauth build && bun run --cwd ../container build && bun run --cwd ../docker-git-session-sync build",
    "test": "vitest run --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProverCoderAI/docker-git.git"
  },
  "keywords": [
    "effect",
    "typescript",
    "vite",
    "console"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ProverCoderAI/docker-git/issues"
  },
  "homepage": "https://github.com/ProverCoderAI/docker-git#readme",
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@prover-coder-ai/docker-git-auth-oauth": "workspace:*",
    "@prover-coder-ai/docker-git-container": "workspace:*",
    "@effect/cli": "^0.77.0",
    "@effect/cluster": "^0.60.2",
    "@effect/experimental": "^0.61.1",
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "@effect/printer": "^0.51.0",
    "@effect/printer-ansi": "^0.51.0",
    "@effect/rpc": "^0.76.2",
    "@effect/schema": "^0.75.5",
    "@effect/sql": "^0.52.1",
    "@effect/typeclass": "^0.41.0",
    "@effect/workflow": "^0.19.1",
    "effect": "^3.22.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@prover-coder-ai/docker-git-session-sync": "workspace:*",
    "@biomejs/biome": "^2.5.12",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "latest",
    "@effect/vitest": "^0.30.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@prover-coder-ai/eslint-plugin-suggest-members": "^0.0.26",
    "@ton-ai-core/vibecode-linter": "^1.0.11",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "typescript-eslint": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-codegen": "0.34.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "fast-check": "^4.9.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "globals": "^17.12.0",
    "jscpd": "^5.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js"
    },
    "./usecases/*": {
      "types": "./dist/usecases/*.d.ts",
      "import": "./dist/usecases/*.js"
    },
    "./shell/*": {
      "types": "./dist/shell/*.d.ts",
      "import": "./dist/shell/*.js"
    }
  }
}

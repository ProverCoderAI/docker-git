{"timestamp":"2026-02-03T18:30:05.918Z","type":"response_item","payload":{"type":"custom_tool_call","status":"completed","call_id":"call_QK4VPIiXRtqOEv08HDK0XfpH","name":"apply_patch","input":"*** Begin Patch\n*** Update File: /home/user/docker-git/effect-template/packages/web/src/app/page.tsx\n@@\n-        const socket = new WebSocket(buildWsUrl(projectId, wsPort))\n+        const socket = new WebSocket(buildWsUrl(projectId, wsPort))\n+        const connectTimeout = window.setTimeout(() => {\n+          updateSessionStatus(sessionId, \"error\")\n+          terminal.write(\"\\r\\n[terminal timeout: unable to connect]\\r\\n\")\n+          socket.close()\n+        }, 12000)\n@@\n-        socket.onopen = () => {\n+        socket.onopen = () => {\n+          window.clearTimeout(connectTimeout)\n           updateSessionStatus(sessionId, \"connected\")\n           scheduleFit()\n         }\n@@\n-        socket.onerror = () => {\n+        socket.onerror = () => {\n+          window.clearTimeout(connectTimeout)\n           updateSessionStatus(sessionId, \"error\")\n           terminal.write(\"\\r\\n[terminal error]\\r\\n\")\n         }\n \n-        socket.onclose = () => {\n+        socket.onclose = () => {\n+          window.clearTimeout(connectTimeout)\n           updateSessionStatus(sessionId, \"detached\")\n           terminal.write(\"\\r\\n[disconnected]\\r\\n\")\n         }\n*** End Patch"}}

+// ─── Project + global system prompts ───────────────────────────────────────
+
+const SYSTEM_PROMPT_MAX_BYTES = 1024 * 256;
+
+type ProjectPromptDescriptor = {
+	kind: ProjectPromptKindJson;
+	label: string;
+	fileName: string;
+	globalDir: string;
+	envOverrideKey: string;
+	overrideFileName: string;
+};
+
+const PROJECT_PROMPT_DESCRIPTORS: ProjectPromptDescriptor[] = [
+	{
+		kind: "codex",
+		label: "Codex",
+		fileName: "AGENTS.md",
+		globalDir: ".codex",
+		envOverrideKey: "CODEX_SYSTEM_PROMPT_OVERRIDE_FILE",
+		overrideFileName: "codex.md",
+	},
+	{
+		kind: "claude",
+		label: "Claude Code",
+		fileName: "CLAUDE.md",
+		globalDir: ".claude",
+		envOverrideKey: "CLAUDE_SYSTEM_PROMPT_OVERRIDE_FILE",
+		overrideFileName: "claude.md",
+	},
+	{
+		kind: "gemini",
+		label: "Gemini",
+		fileName: "GEMINI.md",
+		globalDir: ".gemini",
+		envOverrideKey: "GEMINI_SYSTEM_PROMPT_OVERRIDE_FILE",
+		overrideFileName: "gemini.md",
+	},
+];
+
+function findPromptDescriptor(kind: ProjectPromptKindJson): ProjectPromptDescriptor {
+	const descriptor = PROJECT_PROMPT_DESCRIPTORS.find((item) => item.kind === kind);
+	if (!descriptor) throw new Error(`unknown prompt kind: ${kind}`);
+	return descriptor;
+}
+
+function currentHomePath(): string {
+	const home = process.env.HOME?.trim();
+	if (!home) throw new Error("HOME is not set");
+	return home;
+}
+
+function globalPromptHostPath(descriptor: ProjectPromptDescriptor): string {
+	return join(currentHomePath(), descriptor.globalDir, descriptor.fileName);
+}
+
+function promptHostPath(
+	projectPath: string,
+	scope: ProjectPromptScopeJson,
+	descriptor: ProjectPromptDescriptor,
+): string {
+	return scope === "project"
+		? join(projectPath, descriptor.fileName)
+		: globalPromptHostPath(descriptor);
+}
+
+function dockerGitOverrideHostPath(descriptor: ProjectPromptDescriptor): string {
+	return join(
+		currentHomePath(),
+		".docker-git",
+		".orch",
+		"prompts",
+		"global",
+		descriptor.overrideFileName,
+	);
+}
+
+function dockerGitOverrideContainerPath(descriptor: ProjectPromptDescriptor): string {
+	const containerHome =
+		process.env.DOCKER_GIT_SKILLER_CONTAINER_HOME_PATH?.trim() || currentHomePath();
+	return [
+		containerHome.replace(/\/+$/u, ""),
+		".docker-git",
+		".orch",
+		"prompts",
+		"global",
+		descriptor.overrideFileName,
+	].join("/");
+}
+
+function decodeEscapedUnicodePromptText(content: string): string {
+	const escapeMatches = content.match(/\\u[0-9a-fA-F]{4}/gu) ?? [];
+	if (escapeMatches.length < 4) return content;
+	const decoded = content.replace(
+		/\\u([0-9a-fA-F]{4})/gu,
+		(_sequence, hex: string) => String.fromCharCode(Number.parseInt(hex, 16)),
+	);
+	const cyrillicMatches = decoded.match(/[А-Яа-яЁё]/gu) ?? [];
+	return cyrillicMatches.length >= 4 ? decoded : content;
+}
+
+function readPromptContent(filePath: string): string {
+	const raw = readFileSync(filePath, "utf-8");
+	const decoded = decodeEscapedUnicodePromptText(raw);
+	if (decoded !== raw) {
+		writeFileSync(filePath, decoded, "utf-8");
+	}
+	return decoded;
+}
+
+function readPromptFile(
+	projectPath: string,
+	scope: ProjectPromptScopeJson,
+	descriptor: ProjectPromptDescriptor,
+): ProjectPromptFileJson {
+	const filePath = promptHostPath(projectPath, scope, descriptor);
+	if (!existsSync(filePath)) {
+		return {
+			scope,
+			kind: descriptor.kind,
+			label: descriptor.label,
+			file_name: descriptor.fileName,
+			path: filePath,
+			exists: false,
+			bytes: 0,
+			content: "",
+		};
+	}
+	const stat = statSync(filePath);
+	if (!stat.isFile()) {
+		return {
+			scope,
+			kind: descriptor.kind,
+			label: descriptor.label,
+			file_name: descriptor.fileName,
+			path: filePath,
+			exists: false,
+			bytes: 0,
+			content: "",
+		};
+	}
+	const content = readPromptContent(filePath);
+	return {
+		scope,
+		kind: descriptor.kind,
+		label: descriptor.label,
+		file_name: descriptor.fileName,
+		path: filePath,
+		exists: true,
+		bytes: Buffer.byteLength(content, "utf8"),
+		content,
+	};
+}
+
+function readEnvText(envPath: string): string {
+	return existsSync(envPath) ? readFileSync(envPath, "utf-8") : "";
+}
+
+function writeEnvOverride(key: string, value: string | null): void {
+	const envPath = process.env.DOCKER_GIT_SKILLER_HOST_ENV_GLOBAL_PATH?.trim();
+	if (!envPath) return;
+	const raw = readEnvText(envPath);
+	const nextLines = raw
+		.split(/\r?\n/u)
+		.filter((line) => line.trim().length > 0)
+		.filter((line) => !line.startsWith(`${key}=`));
+	if (value !== null) nextLines.push(`${key}=${value}`);
+	mkdirSync(dirname(envPath), { recursive: true });
+	writeFileSync(envPath, nextLines.length === 0 ? "" : `${nextLines.join("\n")}\n`, "utf-8");
+}
+
+export function listProjectPrompts(projectPath: string): ProjectPromptsSnapshotJson {
+	const prompts: ProjectPromptFileJson[] = [];
+	for (const scope of ["project", "global"] satisfies ProjectPromptScopeJson[]) {
+		for (const descriptor of PROJECT_PROMPT_DESCRIPTORS) {
+			prompts.push(readPromptFile(projectPath, scope, descriptor));
+		}
+	}
+	return { project_path: projectPath, prompts };
+}
+
+export function writeProjectPrompt(
+	projectPath: string,
+	scope: ProjectPromptScopeJson,
+	kind: ProjectPromptKindJson,
+	content: string,
+): ProjectPromptsSnapshotJson {
+	const bytes = Buffer.byteLength(content, "utf8");
+	if (bytes > SYSTEM_PROMPT_MAX_BYTES) {
+		throw new Error(`prompt is too large: maximum ${SYSTEM_PROMPT_MAX_BYTES} bytes`);
+	}
+	const descriptor = findPromptDescriptor(kind);
+	const filePath = promptHostPath(projectPath, scope, descriptor);
+	mkdirSync(dirname(filePath), { recursive: true });
+	writeFileSync(filePath, content, "utf-8");
+	if (scope === "global") {
+		const overridePath = dockerGitOverrideHostPath(descriptor);
+		mkdirSync(dirname(overridePath), { recursive: true });
+		writeFileSync(overridePath, content, "utf-8");
+		writeEnvOverride(descriptor.envOverrideKey, dockerGitOverrideContainerPath(descriptor));
+	}
+	return listProjectPrompts(projectPath);
+}
+
+export function deleteProjectPrompt(
+	projectPath: string,
+	scope: ProjectPromptScopeJson,
+	kind: ProjectPromptKindJson,
+): ProjectPromptsSnapshotJson {
+	const descriptor = findPromptDescriptor(kind);
+	const filePath = promptHostPath(projectPath, scope, descriptor);
+	if (existsSync(filePath)) rmSync(filePath, { force: true });
+	if (scope === "global") {
+		const overridePath = dockerGitOverrideHostPath(descriptor);
+		if (existsSync(overridePath)) rmSync(overridePath, { force: true });
+		writeEnvOverride(descriptor.envOverrideKey, null);
+	}
+	return listProjectPrompts(projectPath);
+}
+

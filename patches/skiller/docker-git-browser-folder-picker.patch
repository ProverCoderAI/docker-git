+
+function SystemPromptEditor({
+  onDelete,
+  onSave,
+  prompt,
+}: {
+  onDelete: (prompt: ProjectPromptFile) => Promise<void>;
+  onSave: (prompt: ProjectPromptFile, content: string) => Promise<void>;
+  prompt: ProjectPromptFile;
+}) {
+  const [draft, setDraft] = useState(prompt.content);
+  const [busy, setBusy] = useState<"delete" | "save" | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const dirty = draft !== prompt.content;
+
+  useEffect(() => {
+    setDraft(prompt.content);
+    setError(null);
+  }, [prompt.content, prompt.path]);
+
+  async function savePrompt() {
+    setBusy("save");
+    setError(null);
+    try {
+      await onSave(prompt, draft);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : String(err));
+    } finally {
+      setBusy(null);
+    }
+  }
+
+  async function deletePrompt() {
+    if (!window.confirm(`Delete ${prompt.label} ${prompt.scope} prompt?`)) return;
+    setBusy("delete");
+    setError(null);
+    try {
+      await onDelete(prompt);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : String(err));
+    } finally {
+      setBusy(null);
+    }
+  }
+
+  return (
+    <div className="flex min-h-[260px] flex-col rounded-lg border border-border/50 bg-muted/10 p-3">
+      <div className="mb-2 min-w-0">
+        <div className="flex items-center justify-between gap-2">
+          <p className="truncate text-sm font-[590]">{prompt.label}</p>
+          <span className="shrink-0 text-[10px] text-muted-foreground">
+            {prompt.exists ? `${prompt.bytes} bytes` : "not created"}
+          </span>
+        </div>
+        <p className="mt-1 truncate font-mono text-[10px] text-muted-foreground/70" title={displayFolderPath(prompt.path)}>
+          {displayFolderPath(prompt.path)}
+        </p>
+      </div>
+      <textarea
+        className="min-h-[150px] flex-1 resize-y rounded-md border border-border/60 bg-background/70 px-2 py-2 font-mono text-xs leading-relaxed outline-none focus:border-primary/50"
+        spellCheck={false}
+        value={draft}
+        onChange={(event) => setDraft(event.currentTarget.value)}
+      />
+      {error && (
+        <p className="mt-2 line-clamp-2 text-xs text-destructive">{error}</p>
+      )}
+      <div className="mt-3 flex justify-end gap-2">
+        <Button
+          size="sm"
+          variant="ghost"
+          disabled={busy !== null}
+          onClick={deletePrompt}
+        >
+          <Trash2 className="size-3.5" />
+          {busy === "delete" ? "Deleting..." : "Delete"}
+        </Button>
+        <Button
+          size="sm"
+          variant="outline"
+          disabled={!dirty || busy !== null}
+          onClick={savePrompt}
+        >
+          <Save className="size-3.5" />
+          {busy === "save" ? "Saving..." : "Save"}
+        </Button>

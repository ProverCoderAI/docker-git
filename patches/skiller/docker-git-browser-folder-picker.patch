+          const groupPrompts = prompts
+            .filter((prompt) => prompt.scope === group.scope)
+            .sort((left, right) => (promptSortOrder[left.kind] ?? 99) - (promptSortOrder[right.kind] ?? 99));
+          return (
+            <section key={group.scope} className="space-y-2">
+              <div>
+                <h3 className="text-sm font-[590]">{group.title}</h3>
+                <p className="text-xs text-muted-foreground">{group.description}</p>
+              </div>
+              <div className="grid gap-2 xl:grid-cols-3">
+                {groupPrompts.map((prompt) => (
+                  <SystemPromptEditor
+                    key={`${prompt.scope}:${prompt.kind}`}

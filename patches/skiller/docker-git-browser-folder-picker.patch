+
+function SystemPromptsSection({
+  isLoading,
+  onDelete,
+  onSave,
+  prompts,
+}: {
+  isLoading: boolean;
+  prompts: ProjectPromptFile[];
+  onDelete: (prompt: ProjectPromptFile) => Promise<void>;
+  onSave: (prompt: ProjectPromptFile, content: string) => Promise<void>;
+}) {
+  return (
